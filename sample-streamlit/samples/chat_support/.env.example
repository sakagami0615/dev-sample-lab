# LLM_PROVIDER: 常に必須。"openai" または "ollama" のいずれかを指定する。
LLM_PROVIDER=

# OpenAIを使う場合(LLM_PROVIDER=openai)は必須。
OPENAI_API_KEY=

# OpenAIを使う場合は必須。例: gpt-4o-mini
OPENAI_MODEL=

# Ollamaを使う場合(LLM_PROVIDER=ollama)は必須。例: http://localhost:11434/v1
OLLAMA_BASE_URL=

# Ollamaを使う場合は必須。Ollama自体に認証がなくても、OpenAI SDKの必須パラメータ
# を満たすための実際のキー値をここで指定する(ダミー値をコードに埋め込まない)。
OLLAMA_API_KEY=

# Ollamaを使う場合は必須。例: llama3.1
OLLAMA_MODEL=
